# Database
# Local Postgres or Neon. On Vercel, this must match the Neon DB you seed.
# If Neon integration uses STORAGE_DATABASE_URL, copy that value into DATABASE_URL
# (or leave DATABASE_URL empty and the app will fall back to STORAGE_DATABASE_URL).
DATABASE_URL="postgresql://thepub:thepub@localhost:5432/thepub?schema=public"
# STORAGE_DATABASE_URL=""

# Auth.js / NextAuth
AUTH_SECRET="generate-a-long-random-string"
# Local:
AUTH_URL="http://localhost:3000"
# Production (Vercel) MUST be:
# AUTH_URL="https://thepubrestia.vercel.app"

# Email (Resend) — required for magic link / password recovery
RESEND_API_KEY=""
EMAIL_FROM="The Pub GameStore <noreply@example.com>"

# Vercel Blob (Phase 2+) — optional for local; required for image uploads
# Create a store at https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# App
NEXT_PUBLIC_APP_NAME="The Pub GameStore"
NEXT_PUBLIC_DEFAULT_LOCATION_TZ="America/Mexico_City"
